#!/bin/bash

set -e

if [[ -z "$1" ]]; then
  echo "Usage: linear_kickoff <linear-url>"
  exit 1
fi

if ! command -v gh &> /dev/null; then
  echo "Error: gh CLI is not installed"
  exit 1
fi

# Extract branch name from Linear URL (issue-id/slug)
branch_name=$(echo "$1" | sed -E 's|.*/issue/([^/]+/[^/]+).*|\1|')

if [[ -z "$branch_name" || "$branch_name" == "$1" ]]; then
  echo "Error: Could not parse Linear URL"
  exit 1
fi

echo "Starting kickoff for: $branch_name"

# Stash any uncommitted changes
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Stashing uncommitted changes..."
  git stash push -m "linear_kickoff: auto-stash before $branch_name"
fi

# Checkout main and update from origin
echo "Checking out main and pulling latest..."
git checkout main
git pull origin main

# Create and checkout new branch
echo "Creating branch: $branch_name"
if git show-ref --verify --quiet "refs/heads/$branch_name"; then
  echo "Branch exists locally, checking out..."
  git checkout "$branch_name"
elif git show-ref --verify --quiet "refs/remotes/origin/$branch_name"; then
  echo "Branch exists on remote, checking out and tracking..."
  git checkout -b "$branch_name" "origin/$branch_name"
else
  git checkout -b "$branch_name"
fi

# Ensure branch has at least one commit ahead of main
if [[ $(git rev-list --count main.."$branch_name") -eq 0 ]]; then
  git commit --allow-empty -m "chore: kickoff $branch_name"
fi

# Push branch
git push -u origin "$branch_name"

# Create draft PR if no open/draft PR exists
pr_state=$(gh pr view "$branch_name" --json state --jq '.state' 2>/dev/null || echo "")
if [[ "$pr_state" != "OPEN" && "$pr_state" != "DRAFT" ]]; then
  echo "Creating draft PR..."
  repo_root=$(git rev-parse --show-toplevel)
  gh pr create --draft --title "$branch_name" --assignee @me --body-file "$repo_root/.github/pull_request_template.md"
else
  echo "PR already exists"
fi

# Generate deterministic session ID from branch name
session_id=$(python3 -c "import uuid; print(uuid.uuid5(uuid.NAMESPACE_DNS, '$branch_name'))")

# Get claude project path for current directory
project_path="$HOME/.claude/projects/$(pwd | tr '/' '-')"
session_file="$project_path/$session_id.jsonl"

# Create minimal session file if it doesn't exist
if [ -z $LINEAR_KICKOFF_INITIAL_MESSAGE ]; then
LINEAR_KICKOFF_INITIAL_MESSAGE="Please run the /linear-context skill to grab context for the current task"
fi

LINEAR_KICKOFF_INITIAL_MESSAGE
if [[ ! -f "$session_file" ]]; then
  mkdir -p "$project_path"
  msg_uuid=$(uuidgen | tr '[:upper:]' '[:lower:]')
  timestamp=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")
  cat > "$session_file" << EOF
{"type":"user","parentUuid":null,"uuid":"$msg_uuid","sessionId":"$session_id","cwd":"$(pwd)","gitBranch":"$branch_name","timestamp":"$timestamp","message":{"role":"user","content":"Please run the /linear-context skill to grab context for the current task"}}
EOF
fi

# Start or resume Claude Code session in tmux window 3
echo "Starting Claude Code session: $branch_name"
current_window=$(tmux display-message -p '#I')
tmux respawn-window -t :3 -k "zsh -c 'claude --resume $session_id; exec zsh -l'"
tmux select-window -t ":$current_window"
tmux rename-window -t :3 claude

echo "Ready to work on $branch_name"
