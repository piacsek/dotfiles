#!/usr/bin/env bash
# Read a "path[:line[:col]]" token from stdin (selected WORD in copy-mode)
# and open it in the nvim instance running in window 1.

raw=$(cat)
# Pull the longest path-like token from the line: chars typical in paths,
# containing a '/' or a '.', optionally followed by :line:col.
token=$(printf '%s\n' "$raw" \
  | grep -oE '[A-Za-z0-9_./~-]*[/.][A-Za-z0-9_./~-]+(:[0-9]+){0,2}' \
  | awk '{ print length, $0 }' | sort -nr | head -1 | cut -d' ' -f2-)
[ -z "$token" ] && exit 0

path="${token%%:*}"
line=""
col=""
if [ "$path" != "$token" ]; then
  rest="${token#*:}"
  line="${rest%%:*}"
  if [ "$line" != "$rest" ]; then
    rest2="${rest#*:}"
    col="${rest2%%:*}"
  fi
fi
[[ "$line" =~ ^[0-9]+$ ]] || line=""
[[ "$col"  =~ ^[0-9]+$ ]] || col=""

# Find an nvim pane in window 1, fall back to pane 1.
read -r nvim_pane nvim_cwd < <(tmux list-panes -t :1 \
  -F '#{pane_index} #{pane_current_command} #{pane_current_path}' \
  | awk '$2=="nvim"{print $1, $3; exit}')
if [ -z "$nvim_pane" ]; then
  nvim_pane=1
  nvim_cwd=$(tmux display-message -p -t ":1.1" '#{pane_current_path}')
fi

# Resolve relative paths against nvim's cwd.
resolved="$path"
case "$path" in
  /*) ;;
  ~*) resolved="${path/#\~/$HOME}" ;;
  *)  resolved="$nvim_cwd/$path" ;;
esac

tmux select-window -t :1
tmux select-pane -t "$nvim_pane"
tmux send-keys Escape Escape

if [ -e "$resolved" ]; then
  if [ -n "$line" ] && [ -n "$col" ]; then
    tmux send-keys ":e +'call\\ cursor($line,$col)'\\ $resolved" Enter
  elif [ -n "$line" ]; then
    tmux send-keys ":e +$line $resolved" Enter
  else
    tmux send-keys ":e $resolved" Enter
  fi
else
  # Fall back to fuzzy finder, prepopulated with the path (no line/col).
  # Escape single quotes for the Lua string.
  q="${path//\'/\\\'}"
  tmux send-keys -l ":lua vim.defer_fn(function() require('fzf-lua').files({ query = '$q' }) end, 50)"
  tmux send-keys Enter
fi
