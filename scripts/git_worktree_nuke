#!/usr/bin/env bash

set -u

repo="${1:-.}"

if ! main=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  echo "$(basename "$0"): not a git repo: $repo" >&2
  exit 2
fi

cd "$(dirname "$main")" || exit 2

removed=0
failed=0
first=1

while IFS= read -r line; do
  case "$line" in
    "worktree "*) ;;
    *) continue ;;
  esac
  if [ "$first" -eq 1 ]; then
    first=0
    continue
  fi
  path="${line#worktree }"
  if git worktree remove --force --force "$path" 2>/dev/null || [ ! -e "$path" ]; then
    echo "removed $path"
    removed=$((removed + 1))
  else
    echo "FAILED  $path" >&2
    failed=$((failed + 1))
  fi
done < <(git worktree list --porcelain)

git worktree prune

echo "$removed removed, $failed failed"
[ "$failed" -eq 0 ]
