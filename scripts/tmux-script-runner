#!/usr/bin/env bash
# fzf script selector for a tmux popup (bound to M-r).
#
#   <CR>   run the script in a new pane in the current window
#   <C-w>  run the script in a new window in the current session
#   <C-f>  run the script in the floating "scratch" session (the M-t popup)
#
# Source list: a per-directory `.available-scripts` file if present (each line
# a runnable command), otherwise the contents of ~/scripts (run by full path).
#
# A self-managing script (one that runs its own `tmux split-window` etc.) is run
# directly: its own tmux commands target the caller pane, so it builds exactly
# the layout it wants with no wrapper pane left behind. Everything else runs as
# the start-command of a new pane/window, then drops to an interactive shell so
# the pane survives a fast-exiting command.
#
# Run from a display-popup: commands here that omit -t target the pane/session
# *behind* the popup, which is the caller — so no pane id needs to be passed
# (tmux doesn't expand #{...} in a popup's command string anyway).
set -euo pipefail

if [[ -f .available-scripts ]]; then
	src=file
	list=$(grep -vE '^[[:space:]]*(#|$)' .available-scripts || true)
else
	src=dir
	list=$(ls -1 "$HOME/scripts" 2>/dev/null || true)
fi

[[ -z "$list" ]] && { echo "No scripts found."; sleep 1; exit 0; }

out=$(printf '%s\n' "$list" | fzf --prompt='Scripts> ' --expect=ctrl-w,ctrl-f) || exit 0
key=$(printf '%s\n' "$out" | head -1)
choice=$(printf '%s\n' "$out" | sed -n '2p')
[[ -z "$choice" ]] && exit 0

if [[ "$src" == dir ]]; then
	cmd="$HOME/scripts/$choice"
else
	cmd="$choice"
fi

# <C-f>: send the command to the floating "scratch" session's current pane
# (create it detached if it doesn't exist yet — M-t toggles its popup).
if [[ "$key" == ctrl-f ]]; then
	tmux has-session -t scratch 2>/dev/null || tmux new-session -d -s scratch
	tmux send-keys -t scratch "$cmd" C-m
	exit 0
fi

# Self-managing scripts build their own layout — run directly (like the old
# nvim `system()` picker) so their tmux commands target the caller pane and no
# wrapper pane is left behind. The CR/C-w distinction doesn't apply to them.
if [[ "$src" == dir ]] && grep -qE 'tmux[[:space:]]+(split-window|new-window|new-session)' "$cmd" 2>/dev/null; then
	exec "$cmd"
fi

case "$key" in
ctrl-w) tmux new-window "$cmd; exec \$SHELL" ;;
*) tmux split-window "$cmd; exec \$SHELL" ;;
esac
