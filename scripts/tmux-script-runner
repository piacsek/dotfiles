#!/usr/bin/env bash
# fzf script selector for a tmux popup (bound to M-r).
#
#   <CR>   run the script in a new pane (vertical split) in the current window
#   <C-v>  run the script in a vertical-split pane (side by side)
#   <C-s>  run the script in a horizontal-split pane (stacked)
#   <C-w>  run the script in a new window in the current session
#
# Source list: the nearest `.available-scripts` file, searching from the cwd
# upward to / (each line a runnable command, blank/`#` lines ignored). If none
# is found, just warn — there is no global fallback.
#
# A self-managing script (one that runs its own `tmux split-window` etc.) is run
# directly: its own tmux commands target the caller pane, so it builds exactly
# the layout it wants with no wrapper pane left behind. Everything else runs as
# the start-command of a new pane/window, then drops to an interactive shell so
# the pane survives a fast-exiting command.
#
# Run from a display-popup: commands here that omit -t target the pane/session
# *behind* the popup, which is the caller — so no pane id needs to be passed
# (tmux doesn't expand #{...} in a popup's command string anyway).
set -euo pipefail

list=""
dir=$PWD
while :; do
	if [[ -s "$dir/.available-scripts" ]]; then
		list=$(grep -vE '^[[:space:]]*(#|$)' "$dir/.available-scripts" || true)
		break
	fi
	[[ "$dir" == "/" ]] && break
	dir=$(dirname "$dir")
done

if [[ -z "$list" ]]; then
	echo "No .available-scripts file found from $PWD upward"
	sleep 2
	exit 0
fi

out=$(printf '%s\n' "$list" | fzf --prompt='Scripts> ' --expect=ctrl-w,ctrl-s,ctrl-v) || exit 0
key=$(printf '%s\n' "$out" | head -1)
cmd=$(printf '%s\n' "$out" | sed -n '2p')
[[ -z "$cmd" ]] && exit 0

# Self-managing scripts build their own layout — run directly (like the old nvim
# `system()` picker) so their tmux commands target the caller pane and no wrapper
# pane is left behind. Detected when the command's first word resolves (via PATH
# or as a path) to a file that runs its own tmux split/new-window/new-session.
script_file=$(command -v "${cmd%% *}" 2>/dev/null || printf '%s' "${cmd%% *}")
if [[ -f "$script_file" ]] && grep -qE 'tmux[[:space:]]+(split-window|new-window|new-session)' "$script_file" 2>/dev/null; then
	exec sh -c "$cmd"
fi

case "$key" in
ctrl-w) tmux new-window "$cmd; exec \$SHELL" ;;
ctrl-s) tmux split-window -v "$cmd; exec \$SHELL" ;;
*) tmux split-window -h "$cmd; exec \$SHELL" ;;
esac
