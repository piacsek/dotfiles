#!/usr/bin/env bash
# fzf script selector for a tmux popup (bound to M-r).
#
#   <CR>   run the script in a new pane in the current window
#   <C-w>  run the script in a new window in the current session
#
# Source list: a per-directory `.available-scripts` file if present (each line
# a runnable command), otherwise the contents of ~/scripts (run by full path).
#
# The target (pane or window) is created as a normal shell, then the command is
# typed into it with send-keys. This keeps the pane alive after the command
# exits and lets self-managing scripts (e.g. ones that run their own
# `tmux split-window`) behave exactly as if typed at the prompt.
#
# Arg $1 is the calling pane id (#{pane_id}), so spawned panes/windows land in
# the right window/session regardless of the popup being its own overlay.
set -euo pipefail

log=/tmp/tmux-script-runner.log
exec 2>>"$log"
echo "=== $(date '+%H:%M:%S') invoked: args=[$*] TMUX_PANE=${TMUX_PANE:-} ===" >>"$log"
set -x

target_pane="${1:-}"

if [[ -f .available-scripts ]]; then
	src=file
	list=$(grep -vE '^[[:space:]]*(#|$)' .available-scripts || true)
else
	src=dir
	list=$(ls -1 "$HOME/scripts" 2>/dev/null || true)
fi

[[ -z "$list" ]] && { echo "No scripts found."; sleep 1; exit 0; }

out=$(printf '%s\n' "$list" | fzf --prompt='Scripts> ' --expect=ctrl-w) || exit 0
key=$(printf '%s\n' "$out" | head -1)
choice=$(printf '%s\n' "$out" | sed -n '2p')
[[ -z "$choice" ]] && exit 0

if [[ "$src" == dir ]]; then
	cmd="$HOME/scripts/$choice"
else
	cmd="$choice"
fi

if [[ -n "$target_pane" ]]; then
	session=$(tmux display -p -t "$target_pane" '#{session_name}')
else
	session=$(tmux display -p '#{session_name}')
fi

case "$key" in
ctrl-w)
	pane=$(tmux new-window -t "$session:" -P -F '#{pane_id}')
	;;
*)
	if [[ -n "$target_pane" ]]; then
		pane=$(tmux split-window -t "$target_pane" -P -F '#{pane_id}')
	else
		pane=$(tmux split-window -P -F '#{pane_id}')
	fi
	;;
esac

# -l sends the command literally (no key-name interpretation), then Enter runs it.
tmux send-keys -t "$pane" -l "$cmd"
tmux send-keys -t "$pane" C-m
