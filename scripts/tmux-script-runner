#!/usr/bin/env bash
set -euo pipefail

files=()
dir=$PWD
while :; do
	[[ -s "$dir/.available-scripts" ]] && files+=("$dir/.available-scripts")
	[[ "$dir" == "/" ]] && break
	dir=$(dirname "$dir")
done
global="$HOME/.available-scripts"
if [[ -s "$global" && ! " ${files[*]-} " == *" $global "* ]]; then
	files+=("$global")
fi

list=""
if ((${#files[@]})); then
	list=$(cat "${files[@]}" | grep -vE '^[[:space:]]*(#|$)' | awk '!seen[$0]++' || true)
fi

if [[ -z "$list" ]]; then
	echo "No .available-scripts file found from $PWD upward or in $HOME"
	sleep 2
	exit 0
fi

out=$(printf '%s\n' "$list" | fzf --prompt='Scripts> ' --expect=ctrl-w,ctrl-s,ctrl-v) || exit 0
key=$(printf '%s\n' "$out" | head -1)
cmd=$(printf '%s\n' "$out" | sed -n '2p')
[[ -z "$cmd" ]] && exit 0

script_file=$(command -v "${cmd%% *}" 2>/dev/null || printf '%s' "${cmd%% *}")
if [[ -f "$script_file" ]] && grep -qE 'tmux[[:space:]]+(new-window|new-session)' "$script_file" 2>/dev/null; then
	exec sh -c "$cmd"
fi

case "$key" in
ctrl-w) tmux new-window "$cmd; exec \$SHELL" ;;
ctrl-s) tmux split-window -v "$cmd; exec \$SHELL" ;;
*) tmux split-window -h "$cmd; exec \$SHELL" ;;
esac
