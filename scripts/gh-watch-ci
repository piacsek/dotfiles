#!/usr/bin/env bash
# Watch the most recent GitHub Actions run for the current branch; if the
# branch has none, fzf-pick from the repo's recent runs. Wired into the tmux
# M-r picker via .available-scripts, but works from any repo shell.
set -euo pipefail

branch=$(git branch --show-current)

run_id=""
if [[ -n "$branch" ]]; then
  run_id=$(gh run list --branch "$branch" -L1 --json databaseId -q '.[0].databaseId' || true)
fi

if [[ -z "$run_id" ]]; then
  echo "No runs for branch '${branch:-<detached>}' — pick one:" >&2
  run_id=$(gh run list -L20 \
    --json databaseId,workflowName,headBranch,status,conclusion,displayTitle \
    -q '.[] | "\(.databaseId)\t\(.workflowName)\t\(.headBranch)\t\(.status) \(.conclusion // "")\t\(.displayTitle)"' |
    fzf --prompt='Runs> ' --with-nth=2.. --delimiter='\t' | cut -f1)
fi

[[ -z "$run_id" ]] && exit 0

exec gh run watch "$run_id" --exit-status
