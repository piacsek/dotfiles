#!/usr/bin/env bash
set -euo pipefail

if ! pgrep -qx Brain.fm; then
	tmux display-message "Brain.fm is not running"
	exit 0
fi

osascript -l JavaScript <<'EOF'
const se = Application("System Events");
const prev = se.processes.whose({ frontmost: true })[0].bundleIdentifier();
Application("com.electron.brain.fm").activate();
delay(0.3);
const p = se.processes.whose({ bundleIdentifier: "com.electron.brain.fm" })[0];
try { p.attributes.byName("AXManualAccessibility").value = true; } catch (e) {}

function findRestart(el, depth) {
  if (depth > 15) return null;
  let kids = [];
  try { kids = el.uiElements(); } catch (e) { return null; }
  for (const k of kids) {
    try {
      if (k.role() === "AXButton" && /^RESTART TIMER/i.test(k.name() || "")) return k;
    } catch (e) {}
    const hit = findRestart(k, depth + 1);
    if (hit) return hit;
  }
  return null;
}

const restart = p.windows.length ? findRestart(p.windows[0], 0) : null;
if (restart) {
  restart.actions.byName("AXPress").perform();
} else {
  se.keyCode(49);
}
Application(prev).activate();
EOF
