#!/usr/bin/env bash
set -euo pipefail

if ! pgrep -qx Brain.fm; then
	tmux display-message "Brain.fm is not running"
	exit 0
fi

prev=$(osascript -e 'tell application "System Events" to get bundle identifier of first process whose frontmost is true')
windows=$(osascript -e 'tell application "System Events" to count windows of (first process whose bundle identifier is "com.electron.brain.fm")')
[[ "$windows" == 0 ]] && open -b com.electron.brain.fm

result=$(osascript -l JavaScript <<'EOF'
const se = Application("System Events");
const p = se.processes.whose({ bundleIdentifier: "com.electron.brain.fm" })[0];
try { p.attributes.byName("AXManualAccessibility").value = true; } catch (e) {}

let restart = null;
let toggle = null;
function walk(el, depth) {
  if (depth > 20 || restart) return;
  let kids = [];
  try { kids = el.uiElements(); } catch (e) { return; }
  for (const k of kids) {
    try {
      if (k.role() === "AXButton") {
        const name = k.name() || "";
        if (/^RESTART TIMER/i.test(name)) { restart = k; return; }
        if (!toggle && (name === "Play" || name === "Pause")) toggle = k;
      }
    } catch (e) {}
    walk(k, depth + 1);
  }
}

for (let i = 0; i < 10 && p.windows.length === 0; i++) delay(0.1);
if (p.windows.length) walk(p.windows[0], 0);

if (restart) { restart.actions.byName("AXPress").perform(); "restarted timer"; }
else if (toggle) { const n = toggle.name(); toggle.actions.byName("AXPress").perform(); n === "Pause" ? "paused" : "playing"; }
else "no player button found";
EOF
)

open -b "$prev"
tmux display-message "Brain.fm: $result"
