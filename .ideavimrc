""" Map leader to space ---------------------
let mapleader=" "


""" Mappings
map <leader>e <Action>(RecentFiles)
map <leader>s <Action>(FileStructurePopup)
map <leader>d <Action>(Compare.SameVersion)
map <leader>f <Action>(FindInPath)
map <leader>x <Action>(CloseContent)
map <leader>u <Action>(Vcs.RollbackChangedLines)
map <leader><Tab> <Action>(NextSplitter)
map <leader><Up> <Action>(com.mnw.tabmover.actions.MoveTabToNextWindow)
map <leader><Right> <Action>(MoveTabRight)
map <leader>r <Action>(RunClass)
map <leader><Space> <Action>(Run)
map <leader>n <Action>(NewElement)
map <leader>mm <Action>(Tool_External Tools_mix format current file)

""" Mappings - Go to...
map <leader>gr <Action>(ChooseRunConfiguration)
map <leader>go <Action>(GotoFile)
map <leader>gd <Action>(GotoDeclaration)
map <leader>g4 <Action>(ActivateRunToolWindow)
map <leader>gs <Action>(ActivateTerminalToolWindow)
map <leader>ga <Action>(GotoAction)
map <leader>gt <Action>(GotoTest)
map <leader>gp <Action>(SelectInProjectView)

""" % to bounce from do to end etc.
set matchit
