""" Map leader to space ---------------------
let mapleader=" "


""" VIM Mappings
map Y y$
map V v$

""" Harpoon
map <leader>e <Action>(RecentFiles)
map <leader>E <Action>(ShowHarpoon)

map <leader><C-j> <Action>(SetHarpoon1)
map <C-j> <Action>(GotoHarpoon1)
map <C-S-j> <C-w><C-w><Action>(GotoHarpoon1)

map <leader><C-k> <Action>(SetHarpoon2)
map <C-k> <Action>(GotoHarpoon2)
map <C-S-k> <C-w><C-w><Action>(GotoHarpoon2)

map <leader><C-l> <Action>(SetHarpoon3)
map <C-l> <Action>(GotoHarpoon3)
map <C-S-l> <C-w><C-w><Action>(GotoHarpoon3)

map <leader><C-h> <Action>(SetHarpoon4)
map <C-h> <Action>(GotoHarpoon4)
map <C-S-h> <C-w><C-w><Action>(GotoHarpoon4)


map <leader>s <Action>(FileStructurePopup)
map <leader>S <Action>(ActivateStructureToolWindow)
map <leader>f <Action>(FindInPath)
map <leader>F <Action>(ReplaceInPath)
map <leader><Esc> <Action>(CloseContent)
map <leader>/ <Action>(CommentByLineComment)
map <leader>r <Action>(RunClass)
map <leader><BS> <Action>(Run)
map <leader>K <Action>(Stop)
map <leader>y <Action>(EditorCopy)
map <leader>p <Action>(EditorPaste)
map <leader>h <Action>(QuickJavaDoc)

""" Mappings - Window management
map <leader>` <Action>(NextProjectWindow)
map <leader><Enter> <Action>(HideAllWindows)
map <Tab> <Action>(NextSplitter)
map <leader><Up> <Action>(com.mnw.tabmover.actions.MoveTabToNextWindow)
map <leader><Down> <Action>(com.mnw.tabmover.actions.MoveTabToNextWindow)
map <leader><Right> <Action>(MoveTabRight)

""" Mappings - VCS
map <leader>u <Action>(Vcs.RollbackChangedLines)
map <leader>gd <Action>(Compare.SameVersion)
map <leader>gg <Action>(ActivateCommitToolWindow)
map <leader>gw <Action>(Github.Open.In.Browser)
map <leader>gy <Action>(GitHub.Copy.Link)
map <leader>gh <Action>(Vcs.ShowTabbedFileHistory)

""" Mappings - Jump to...
map <leader>R <Action>(ChooseRunConfiguration)
map <leader>o <Action>(GotoFile)
map <leader>O <Action>(Scratch.ShowFilesPopup)
map gd <Action>(GotoDeclaration)
map gr <Action>(ShowUsages)
map <leader>[ <Action>(VcsShowPrevChangeMarker)
map <leader>] <Action>(VcsShowNextChangeMarker)
map <leader>3 <Action>(ActivateFindToolWindow)
map <leader>4 <Action>(ActivateRunToolWindow)
map <leader>js <Action>(ActivateTerminalToolWindow)
map <leader>a <Action>(GotoAction)
map <leader>jt <C-w><C-w><Action>(GotoTest)
map <leader>jp <Action>(SelectInProjectView)
map <leader>jd <Action>(ActivateDatabaseToolWindow)
map <leader>jh <Action>(ShowHoverInfo)
map <leader>ji :edit ~/.ideavimrc<cr>

""" Mappings - Elixir
map <C-s> <Action>(Tool_External Tools_mix format current file)

""" AI assistant
map <leader>gi <Action>(ActivateAIAssistantToolWindow)


""" Plugins
set NERDTree 
set highlightedyank
set matchit
set sneak
